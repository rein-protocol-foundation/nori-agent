{
  "id": "rein-partnership",
  "name": "Nori partnership test workflow",
  "description": "Opt-in native Lobster exact-draft human approval and designated test-recipient mail.",
  "enabledByDefault": false,
  "activation": { "onStartup": true },
  "contracts": { "tools": ["rein_partnership"] },
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "channel": {
        "type": "object", "additionalProperties": false,
        "required": ["accountId", "workspaceId", "channelId", "agentId", "botTokenEnvVar"],
        "properties": {
          "accountId": { "type": "string", "minLength": 1 },
          "workspaceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" },
          "channelId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" },
          "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "botTokenEnvVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      },
      "from": { "type": "string", "format": "email" },
      "testRecipients": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "format": "email" } },
      "approverId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" },
      "approvalTtlMs": { "type": "integer", "minimum": 1000, "maximum": 86400000, "default": 3600000 },
      "apiKeyEnvVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "default": "RESEND_API_KEY" }
    },
    "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
    "then": { "required": ["channel", "from", "testRecipients"] }
  }
}
