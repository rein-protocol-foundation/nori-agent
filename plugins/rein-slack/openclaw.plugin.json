{
  "id": "rein-slack",
  "name": "Nori-Agent Isolated Slack",
  "categories": [
    "channels"
  ],
  "description": "Native Slack workspace/channel/thread ingress with shared per-user and audience isolation.",
  "channels": [
    "slack"
  ],
  "channelConfigs": {
    "slack": {
      "label": "Nori-Agent Isolated Slack",
      "description": "Disable bundled Slack and configure the Rein adapter.",
      "schema": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "rein_memory_read",
      "rein_memory_remember",
      "rein_memory_forget"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "agentId",
      "teamId",
      "appId",
      "botUserId",
      "botTokenEnv",
      "appTokenEnv",
      "memoryPath",
      "channels",
      "dmAllowFrom"
    ],
    "properties": {
      "agentId": {
        "const": "main"
      },
      "teamId": {
        "type": "string",
        "pattern": "^T[A-Z0-9]{8,31}$"
      },
      "appId": {
        "type": "string",
        "pattern": "^A[A-Z0-9]{8,31}$"
      },
      "botUserId": {
        "type": "string",
        "pattern": "^[UW][A-Z0-9]{8,31}$"
      },
      "botTokenEnv": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "appTokenEnv": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "memoryPath": {
        "type": "string",
        "minLength": 1
      },
      "requireMention": {
        "type": "boolean",
        "default": true
      },
      "dmAllowFrom": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[UW][A-Z0-9]{8,31}$"
        }
      },
      "channels": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "audience"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[CG][A-Z0-9]{8,31}$"
            },
            "audience": {
              "enum": [
                "public",
                "private"
              ]
            },
            "userIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[UW][A-Z0-9]{8,31}$"
              }
            }
          }
        }
      }
    }
  }
}
