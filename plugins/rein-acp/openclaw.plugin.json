{
  "id": "rein-acp",
  "name": "Rein Director ACP",
  "description": "Opt-in trusted Slack native task controls or the legacy bounded ACP controller.",
  "categories": ["agent-orchestration"],
  "enabledByDefault": false,
  "activation": { "onStartup": true },
  "contracts": { "tools": ["rein_task", "rein_continuation"] },
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "taskLoop": { "type": "boolean", "default": false, "description": "Use additive native task controls without the legacy restricted controller policy. Local pilot only; preserve existing native tools and bindings." },
      "continuation": {
        "type": "object", "additionalProperties": false,
        "description": "Opt-in native managed-flow continuation; custom retention/deletion is unsupported.",
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 },
          "maxNoProgress": { "type": "integer", "minimum": 1, "maximum": 12, "default": 2 },
          "maxRuntimeMs": { "type": "integer", "minimum": 1, "maximum": 86400000, "default": 3600000 },
          "maxActiveFlows": { "type": "integer", "minimum": 1, "maximum": 64, "default": 16 }
        }
      },
      "channel": {
        "type": "object", "additionalProperties": false,
        "required": ["accountId", "workspaceId", "channelId", "agentId", "botTokenEnvVar"],
        "properties": {
          "accountId": { "type": "string", "minLength": 1 },
          "workspaceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" },
          "channelId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" },
          "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "botTokenEnvVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      },
      "harnessAgentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "cwd": { "type": "string", "minLength": 1 }
    },
    "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
    "then": { "required": ["channel", "harnessAgentId", "cwd"] }
  }
}
