{
  "id": "rein-acp",
  "name": "Nori task delegation",
  "description": "Opt-in trusted Slack native task controls or the legacy bounded ACP controller.",
  "categories": ["agent-orchestration"],
  "enabledByDefault": false,
  "activation": { "onStartup": true },
  "contracts": { "tools": ["rein_task", "rein_continuation"] },
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "taskLoop": { "type": "boolean", "default": false, "description": "Use additive native task controls without the legacy restricted controller policy. Local pilot only; preserve existing native tools and bindings." },
      "continuation": {
        "type": "object", "additionalProperties": false,
        "description": "Opt-in native managed-flow continuation; optional minimal terminal-summary copies are retained indefinitely when enabled.",
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 },
          "maxNoProgress": { "type": "integer", "minimum": 1, "maximum": 12, "default": 2 },
          "maxRuntimeMs": { "type": "integer", "minimum": 1, "maximum": 86400000, "default": 3600000 },
          "maxActiveFlows": { "type": "integer", "minimum": 1, "maximum": 64, "default": 16 },
          "retainedSummaries": {
            "type": "object", "additionalProperties": false, "required": ["enabled"],
            "properties": { "enabled": { "type": "boolean", "default": false } }
          }
        }
      },
      "developmentCodex": {
        "type": "object", "additionalProperties": false,
        "required": ["channelId", "sourceFile", "bindingDir", "names", "cwd"],
        "properties": {
          "channelId": { "type": "string" },
          "sourceFile": { "type": "string" }, "bindingDir": { "type": "string" }, "cwd": { "type": "string" },
          "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^NORI_[A-Z0-9_]+$" } }
        }
      },
      "alternateHarness": { "type": "string", "enum": ["claude"] },
      "agentCreationChannelId": { "type": "string", "pattern": "^[CG][A-Z0-9]{5,31}$", "description": "Private development channel where a named Slack gateway owner can request native agent creation with one-time approval." },
      "cronDiagnosticsChannelId": { "type": "string", "pattern": "^[CG][A-Z0-9]{5,31}$", "description": "Private development channel where explicitly named Slack gateway owners can inspect operator-job failure receipts." },
      "additionalChannelIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" } },
      "channel": {
        "type": "object", "additionalProperties": false,
        "required": ["accountId", "workspaceId", "channelId", "agentId", "botTokenEnvVar"],
        "properties": {
          "accountId": { "type": "string", "minLength": 1 },
          "workspaceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" },
          "channelId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{5,31}$" },
          "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "botTokenEnvVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      },
      "harnessAgentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "cwd": { "type": "string", "minLength": 1 }
    },
    "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
    "then": { "required": ["channel", "harnessAgentId", "cwd"] }
  }
}
