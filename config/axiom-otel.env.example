# Add these to each profile's private OPENCLAW_STATE_DIR/.env.
# Copy only AXIOM_API_TOKEN from the repository's private .env.local.
# Do not source or copy the entire .env.local into the gateway environment.
AXIOM_API_TOKEN=replace-with-private-token
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-axiom-dataset=nori-traces
OTEL_EXPORTER_OTLP_LOGS_HEADERS=x-axiom-dataset=nori-logs
OTEL_EXPORTER_OTLP_METRICS_HEADERS=x-axiom-metrics-dataset=nori-metrics
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
