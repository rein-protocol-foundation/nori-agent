{
  "agents": {
    "defaults": {
      "workspace": "/absolute/path/to/public-slack-workspace",
      "skipBootstrap": true,
      "compaction": {
        "memoryFlush": {
          "enabled": false
        }
      }
    }
  },
  "memory": {
    "search": {
      "enabled": false,
      "rememberAcrossConversations": false
    }
  },
  "session": {
    "dmScope": "per-account-channel-peer",
    "groupScope": "per-group"
  },
  "tools": {
    "allow": [
      "read",
      "web_search",
      "web_fetch",
      "rein_status",
      "rein_memory_read",
      "rein_memory_remember",
      "rein_memory_forget",
      "rein_member_status",
      "rein_identity_bind_start",
      "rein_identity_bind_status",
      "rein_identity_bind_complete",
      "rein_resources_search",
      "rein_resource_get",
      "rein_events_search",
      "rein_event_get",
      "rein_funds",
      "rein_poll_candidates",
      "rein_vote_type_resolve",
      "rein_proposal_collect",
      "rein_governance_proposal_submit",
      "rein_poll_open",
      "rein_poll_vote",
      "rein_poll_result",
      "rein_proposal_comment_suggest",
      "rein_revision_approve",
      "rein_revision_apply"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "sessions": {
      "visibility": "self"
    },
    "agentToAgent": {
      "enabled": false
    }
  },
  "channels": {
    "slack": {
      "enabled": true
    }
  },
  "plugins": {
    "allow": [
      "rein-operations",
      "rein-slack"
    ],
    "load": {
      "paths": [
        "/absolute/path/to/rein-agent/plugins/rein-operations",
        "/absolute/path/to/rein-agent/plugins/rein-slack"
      ]
    },
    "entries": {
      "slack": {
        "enabled": false
      },
      "rein-operations": {
        "enabled": true
      },
      "rein-slack": {
        "enabled": true,
        "config": {
          "agentId": "main",
          "teamId": "TSYNTH001",
          "appId": "ASYNTH001",
          "botUserId": "USYNTHBOT",
          "botTokenEnv": "SLACK_BOT_TOKEN",
          "appTokenEnv": "SLACK_APP_TOKEN",
          "memoryPath": "/absolute/path/to/private-slack-state/member-memory.sqlite",
          "requireMention": true,
          "channels": [
            {
              "id": "CSYNTHPUB",
              "audience": "public"
            },
            {
              "id": "GSYNTHPRI",
              "audience": "private"
            }
          ],
          "dmAllowFrom": []
        }
      }
    }
  }
}
