  "scripts": {
    "browser:setup": "node scripts/agent-browser-dependency.mjs",
    "browser": "node scripts/agent-browser.mjs",
    "verify:browser": "node scripts/verify-agent-browser.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:discord-privacy": "node scripts/discord-privacy.mjs",
    "probe:discord-routing": "node scripts/probe-discord-routing.mjs",
    "verify:discord-isolation": "node scripts/verify-discord-isolation.mjs",
    "verify:router-console": "node scripts/verify-router-console.mjs",
    "verify:subscriptions": "node scripts/verify-subscriptions.mjs",
    "verify:subscriptions:slack": "node scripts/verify-slack-subscriptions.mjs",
    "verify:subscriptions:managed": "node scripts/verify-managed-magpie.mjs",
    "verify:subscriptions:bailian": "node scripts/verify-bailian-subscription.mjs",
    "eval:subscriptions": "node scripts/evaluate-subscription-routing.mjs",
